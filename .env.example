# ==========================================
# ENGINEER'S PROJECT HUB - ENVIRONMENT CONFIG
# ==========================================

# 1. Supabase PostgreSQL & Auth Credentials
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. MongoDB Database (For AI Chat Logs & User Feedback)
# Optional: Set in Vercel Environment Variables to store chat telemetry in MongoDB Atlas
# If left empty, logs are safely recorded to Vercel serverless logs and local storage.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/engineers_hub?retryWrites=true&w=majority

# Note: If Supabase keys are not set, the app will run in Demo/Local mode 
# so you can explore all features immediately.
